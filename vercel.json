{
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "devCommand": "npm run dev -- --port $PORT",
  "outputDirectory": "dist",
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
